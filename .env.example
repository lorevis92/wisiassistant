# ===== Frontend (Vercel → Environment Variables, prefix VITE_) =====
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# URL pubblico del crawler su Railway (senza slash finale)
VITE_CRAWLER_URL=https://wisiassistant-crawler.up.railway.app

# ===== Supabase Edge Functions (supabase secrets set ...) =====
# Chiavi dei provider AI: metti solo quelle che userai. Il modello si sceglie per cliente in dashboard.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...          (richiesta anche per gli embedding, text-embedding-3-small)
# GOOGLE_API_KEY=AIza...
# MISTRAL_API_KEY=...
# XAI_API_KEY=xai-...
# GROQ_API_KEY=gsk_...
# CRAWLER_URL=https://wisiassistant-crawler.up.railway.app
# CRAWLER_SECRET=una-stringa-lunga-casuale   (stessa del crawler)
# RESEND_API_KEY=re_...
# REPORT_FROM_EMAIL=WISI Assistant <assistant@wisiverse.com>
# PUBLIC_APP_URL=https://assistant.wisiverse.com
# TELEGRAM_WEBHOOK_SECRET=una-stringa-casuale

# ===== Crawler (Railway → Variables) =====
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (service role, NON anon)
# CRAWLER_SECRET=una-stringa-lunga-casuale
# OPENAI_API_KEY=sk-...   (embedding)
# PORT=8080
